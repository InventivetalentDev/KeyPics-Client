{
  "name": "key.pics",
  "version": "1.1.0",
  "description": "Quick, Simple, Consistent, Scalable Key & Button Icons",
  "type": "module",
  "main": "./dist/key.pics.cjs",
  "module": "./dist/key.pics.esm.js",
  "unpkg": "./dist/key.pics.min.js",
  "jsdelivr": "./dist/key.pics.min.js",
  "exports": {
    ".": {
      "import": "./dist/key.pics.esm.js",
      "require": "./dist/key.pics.cjs",
      "default": "./dist/key.pics.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "keyboard",
    "mouse",
    "icons",
    "svg",
    "key.pics"
  ],
  "homepage": "https://key.pics",
  "author": {
    "name": "Haylee Schäfer",
    "email": "mail@inventivetalent.org",
    "url": "https://inventivetalent.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/InventivetalentDev/KeyPics-Client.git"
  },
  "bugs": "https://github.com/InventivetalentDev/KeyPics-Client/issues",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
